module T

(* ALIAS TESTS - WORKING *)

data Boolean : U =
  | True  : Boolean
  | False : Boolean

data Wrapper : U =
  | Left  : Boolean → Wrapper
  | Right : Boolean → Wrapper

record MyRec =
  constructor Rec
  | x : Int
  | y : Int

data Nat : U =
  | Z : Nat
  | S : Nat → Nat

(*
dec chooseType : Wrapper → U
def chooseType (Left True) := String
def chooseType (Left False) := Int
def chooseType (Right True) := Bool
def chooseType (Right False) := Float
*)

dec ( ∧ ) : Boolean → Boolean → Boolean
def ( ∧ ) False r := False
def ( ∧ ) l False := False
def ( ∧ ) _ _ := True

dec matchTest : MyRec → Int
def matchTest (MyRec {x := x'; y := y'}) := x' + y'


