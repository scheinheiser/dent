module T

(* ALIAS TESTS *)
alias Boolean := Bool

dec chooseType : Boolean → Type
def chooseType b := String

dec v : chooseType _
def v := "hello"

(* UNION TESTS *)
data Pair : (a, b : Type) → Type =
  ( × ) : (a, b : Type) → Pair a b

