module Testing

(* WORKING *)
dec chooseType : U
def chooseType :=
  match true to
  | true => Int
  | false => String

(* WORKING *)
dec myInt : Int -> Int
def myInt x := x

(* WORKING *)
dec bint : Int
def bint := 10

(* WORKING *)
dec ( ¬ ) : Bool → Bool
def ( ¬ ) b :=
  match b to
  | true ⇒ false
  | false ⇒ true

(* WORKING *)
dec ( ∧ ) : Bool -> Bool -> Bool
def ( ∧ ) l r :=
  match l to
  | false ⇒ false
  | true ⇒ r

