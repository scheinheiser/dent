  match true to
  | true => Int
  | false => String

(* WORKING *)
dec myInt : Int -> Int
def myInt x := x

(* WORKING *)
dec bint : Int
def bint := 10

(* WORKING *)
dec ( ¬ ) : Bool → Bool
def ( ¬ ) b :=
  match b to
  | true ⇒ false
  | false ⇒ true

(* WORKING *)
dec ( ∧ ) : Bool -> Bool -> Bool
def ( ∧ ) l r :=
  match l to
  | false ⇒ false
  | true ⇒ r

(* NOT WORKING *)
dec ( ∨ ) : Bool -> Bool -> Bool
def ( ∨ ) l r :=
  match l × r to
  | true × _ -> true
  | _ × true -> true
  | _ -> false

(* WORKING (with both the hole or binary expressions) *)
dec aBool : Bool
def aBool :=
  let α : Bool = ¬ true in
  let β : Bool = true ∧ false in
  (*β ∧ (¬ α)*)
  _

(* WORKING *)
dec id : (a : Type) → a → a
def id _ x := x
*)

dec const : (a, b : Type) → a → b → a
def const _ _ x _ := x
