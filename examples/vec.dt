module Vector

data Nat : U =
  | Z : Nat
  | S : Nat → Nat

(*
data Fin : Nat → U =
  | FZ : ∀ (k ~ Nat). Fin (S k)
  | FS : ∀ (k ~ Nat). Fin k → Fin (S k)
*)

data Vec : (n ~ Nat) → (a ~ U) → U =
  | Nil    : ∀ A. Vec Z A
  | ( @: ) : ∀ A. {n ~ Nat} → (v ~ A) → Vec n A → Vec (S n) A

dec empty : ∀ a. Vec Z a
def empty := Nil

dec something : Nat
def something := S (S (S (S (S Z))))

dec test : Vec something Int
def test := 4 @: 3 @: 2 @: 1 @: Nil

dec len : ∀ (n ~ Nat) A. Vec n A → Nat
def len {n} _ := n

(*
dec plus : Nat → Nat → Nat

dec append : ∀ (n ~ Nat) (m ~ Nat) a. Vec m a → Vec n a → Vec (plus m n) a
def append Nil r := r
def append (l @: ls) r := l @: (append ls r)
*)

