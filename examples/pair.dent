module TypeExample

alias IsWorker := Bool

union Pair : (a, b: Type) -> Type = 
  Cross : (a, b: Type) -> Pair a b

record Person : Type = 
  constructor MkPerson
  | name       : String
  | age        : Int
  (*| isEmployed : IsWorker -- a field with an alias doesn't function correctly. *)

dec myInt : Int
def myInt := 5

dec myP : Person
def myP := MkPerson { name = "john"; age = 10 }

