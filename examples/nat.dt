module Nat

data Nat : U =
  | Z : Nat
  | S : Nat → Nat

dec plus : Nat → Nat → Nat
def plus n Z := n
def plus n (S m) := S (n `plus` m)

dec sub : Nat → Nat → Nat
def sub Z n := Z
def sub n Z := n
def sub (S n) (S n') := n `sub` n'

dec mul : Nat → Nat → Nat
def mul n Z := Z
def mul n (S n') := n `plus` (n `mul` n')
