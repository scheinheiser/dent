module TypeExample

alias IsWorker := Bool

union Pair : (a, b: Type) -> Type = 
  | Cross : (a, b: Type) -> Pair a b
  | Bing : IsWorker -> (a, b: Type) -> Pair a b

record Person : Type = 
  constructor MkPerson
  | name       : String
  | age        : Int
  (*| isEmployed : IsWorker -- DOESN'T WORK *)

(* INCONSISTENT *)
(*dec myInt : Int*)
def myInt := 10

(* INCONSISTENT *)
dec myP : Person
def myP := MkPerson { name = "john"; age = 10 }

