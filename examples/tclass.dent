module TypeClass

dec ( ∙ ) : ∀ a b c. (b → c) → (a → b) → a → c
dec ( ∙ ) g f x := g (f x)

class Monoid (a ~ U) where
  | mempty : a

class Functor (f ~ U → U) where
  | fmap : ∀ a b. (a → b) → f a → f b
  | ( <$ ) : ∀ a b. a → f b → f a
default
  def ( <$ ) a _ = fmap id a
end

class Foldable (f ~ U → U) where
  | fold    : ∀ (a ~ [Monoid] U). f a → a
  | foldMap : ∀ a (b ~ [Monoid] U). (a → b) → f a → f b
  | foldr   : ∀ a b. (a → b → b) → b → f a → b
  | foldl   : ∀ a b. (b → a → b) → b → f a → b

class Applicative (f ~ [Functor] U → U) where
  | pure    : ∀ a. a → f a
  | ( <*> ) : ∀ a b. f (a → b) → f a → f b

class Monad (m ~ [Applicative] U → U) where
  | ( >>= ) : ∀ a b. m a → (a → m b) → m b
  | ( >> )  : ∀ a b. m a → m b → m b
  | return  : ∀ a. a → m a
default
  def ( >> ) l r = l >>= λ _ ⇒ r
  def return = pure
end

class Traversable (t: [Foldable, Functor] U → U) where
  | traverse  : ∀ (f ~ [Applicative] U → U) a b. (a → f b) → t a → f (t b)
  | sequenceA : ∀ (f ~ [Applicative] U → U) a.   t (f a) → f (t a)
default
  def traverse f := sequenceA ∙ fmap f
  def sequenceA v := traverse id
end

data List : U → U =
  | Nil   : ∀ a. a → List a
  | (::)  : ∀ a. a → List a → List a

dec singleton : ∀ a. a → List a
def singleton v := [ v ]

dec append : ∀ a. List a → List a → List a
def append [] l := l
def append (x :: xs) l := x :: append l xs

dec concat : ∀ a. List (List a) → List a
def concat [] := 
def concat (x :: xs) := x `append` (concat xs)

dec map : ∀ a b. → (a → b) → List a → List b
def map _ [] := []
def map f (x :: xs) := f x :: map f xs

instance Functor List where
  dec fmap : ∀ a b. (a → b) → List a → List b
  def fmap := map
end

instance Applicative List where
  dec pure : ∀ a. → a → List a
  def pure := singleton

  dec ( <*> ) : ∀ a b. List (a → b) → List a → List b
  def ( <*> ) [] _ := []
  def ( <*> ) (f :: fs) xs := (f `fmap` xs) `append` (fs <*> xs)
end

instance Monad List where
  dec ( >>= ) : ∀ a b. List a → (a → List b) → List b
  def ( >>= ) l f := concat $ map f l

  dec ( >> ) : ∀ a b. List a → List b → List b
  def ( >> ) _ l := l

  dec return : ∀ a. a → List a
  def return := pure
end

dec liftA : ∀ (f ~ [Applicative] U → U) a b. (a → b) → f a → f b
def liftA f a := pure f <*> a
