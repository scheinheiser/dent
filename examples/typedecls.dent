module UDeclSyntax

(* a simple alias to give users more context about a type. *)
alias IsWorker := Bool

(* the type signature is declared similarly to let expressions. *)
data Basket : (price: U) -> U =
  | Apple    : price -> Basket price (* explicit type signature for variants. *)
  | Banana   : price -> Basket price
  | Bag      : Basket price % empty variant
  | ( :. )   : Basket price -> Basket price -> Basket price (* recursive, operator constructor. *)
@rassoc 7 :.

(* unions can contain only operator constructors. *)
union List : U -> U =
  | Nil    : ∀ a. List a
  | ( :: ) : ∀ a. a -> List a -> List a
@rassoc 7 ::

(* the constructor is declared before the definition *)
record Person a = 
  constructor MkPerson
  | name   : String
  | age    : Int
  | status : IsWorker
  | basket : Basket a

dec unsafeHead : (a : U) -> List a -> a
def unsafeHead _ (h :: _) := h

dec getPrice : (a : U) -> Basket a -> a
def getPrice _ (Apple p)  := p
def getPrice _ (Banana p) := p
def getPrice a (l :. r)   := getPrice a l + getPrice a r
def getPrice _ Bag        := 0

(* you can pun record fields *)
dec addEmployee : (price: U) -> String -> Int -> Basket price -> Person price
def addEmployee _ name age basket := MkPerson { age; name; basket; status := true}

dec personBasketPrice : (a : U) -> Person a -> a
def personBasketPrice ap := getPrice a p.basket

dec addItem : (a : U) -> Person a -> Basket a -> Person a
def addItem _ p item := { p where basket := item :. p.basket }
