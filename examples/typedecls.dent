module UDeclSyntax

(* a simple alias to give users more context about a type. *)
alias IsWorker := Bool

(* the type signature is declared similarly to let expressions. *)
data Basket : U -> U =
  | Apple    : ∀ a. a -> Basket a (* explicit type signature for variants. *)
  | Banana   : ∀ a. a -> Basket a
  | Bag      : ∀ a. Basket a % empty variant
  | ( :. )   : ∀ a. Basket a -> Basket a -> Basket a (* recursive, operator constructor. *)
@rassoc 7 :.

(* unions can contain only operator constructors. *)
union List : U -> U =
  | Nil    : ∀ a. List a
  | ( :: ) : ∀ a. a -> List a -> List a
@rassoc 7 ::

(* the constructor is declared before the definition *)
record Person a = 
  constructor MkPerson
  | name   : String
  | age    : Int
  | status : IsWorker
  | basket : Basket a

dec unsafeHead : ∀ a. List a -> a
def unsafeHead (h :: _) := h

dec getPrice : ∀ a. Basket a -> a
def getPrice (Apple p)  := p
def getPrice (Banana p) := p
def getPrice (l :. r)   := getPrice l + getPrice r
def getPrice Bag        := 0

(* you can pun record fields *)
dec addEmployee : ∀ a. String -> Int -> Basket a -> Person a
def addEmployee name age basket := MkPerson { age; name; basket; status := true}

dec personBasketPrice : ∀ a. Person a -> a
def personBasketPrice ap := getPrice a p.basket

dec addItem : ∀ a. Person a -> Basket a -> Person a
def addItem p item := { p where basket := item :. p.basket }
