module ImplicitTest

(*
inline
dec id : {a ~ U} → a → a
def id x := x
*)

(* or *)

(* figure out what to do w implicit underscores. i think i can just ignore them tbh *)
(*
inline
dec id' : ∀ a. a → a
def id' := λ {_} x. x
*)

(*
inline
dec const : {a, b ~ U} → a → b → a
def const := λ x _. id x
*)

(* some proof-y stuff *)

data ( ≡ ) : ∀ A. A → A → U =
  Refl : ∀ A. {a ~ A} → a ≡ a

(*
dec one_plus_one : 1 + 1 ≡ 2
def one_plus_one := Refl
*)

dec comm : ∀ A. {a, b ~ A} → a ≡ b → b ≡ a
def comm Refl := Refl

dec trans : ∀ A. {a, b, c ~ A} → a ≡ b → b ≡ c → a ≡ c
def trans Refl x := x
