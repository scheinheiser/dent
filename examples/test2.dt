module T

(* UNION TESTS - mostly working *)
data Pair : U → U → U =
  ( × ) : ∀ a b. a → b → Pair a b

(*
dec fst : ∀ a b. Pair a b → a
def fst := λ (x × y). x

dec snd : ∀ a b. Pair a b -> b
def snd := λ (x × y). y
*)

dec swap : ∀ a b. Pair a b → Pair b a
def swap (x × y) := y × x

